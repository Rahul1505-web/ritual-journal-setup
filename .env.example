# Client-side (exposed to the browser, must be prefixed with VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_RITUAL_RPC=https://rpc.ritualfoundation.org
VITE_CHAIN_ID=1979
VITE_OWNER_WALLET=
# Optional: enables the WalletConnect connector alongside MetaMask
VITE_WALLETCONNECT_PROJECT_ID=

# Server-side only (never prefixed with VITE_, read via process.env inside server functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# AI Trade Coach (Lovable AI Gateway)
LOVABLE_API_KEY=
